# App URL (used in Twilio and PayPal callbacks)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional dashboard access protection
# If APP_ACCESS_PASSWORD is set, the app requires login at /login
APP_ACCESS_USERNAME=admin
APP_ACCESS_PASSWORD=

# Data store driver
# - postgres: use Neon/Postgres via Prisma (recommended for production)
# - filesystem: local JSON files under data/ (quick local testing)
STORE_DRIVER=postgres

# Optional override for filesystem storage location.
# On Vercel, filesystem mode automatically uses /tmp/auto-caller-data.
# DATA_DIR=/tmp/auto-caller-data

# Neon / Postgres connection string
# Example: postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/autocaller?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB_NAME?sslmode=require

# PayPal billing
# Set PAYPAL_MODE=live for production
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Managed mode (customers do NOT need API keys)
MANAGED_MODE=true
MANAGED_TWILIO_ACCOUNT_SID=
MANAGED_TWILIO_AUTH_TOKEN=
MANAGED_TWILIO_PHONE_NUMBER=
MANAGED_DEFAULT_NUMBER=
MANAGED_NUMBER_POOL=+12025550111,+12025550112
MANAGED_AUTO_PROVISION_NUMBER=true
MANAGED_NUMBER_COUNTRY=US
MANAGED_NUMBER_AREA_CODE=
MANAGED_NUMBER_CONTAINS=
MANAGED_NUMBER_ACTIVATION_PRICE=39
MANAGED_ASSIGN_NUMBER_ON_REGISTRATION=false
MANAGED_OPENAI_API_KEY=
MANAGED_ELEVENLABS_API_KEY=

# Credit pricing model (server-side)
# Example below gives 100% margin on estimated Twilio call cost:
# estimated $0.02 call cost * 2.0 multiplier = $0.04 per credit sold
TWILIO_ESTIMATED_COST_PER_CALL_USD=0.02
CREDIT_MARGIN_MULTIPLIER=2.0

# Optional fallback OpenAI key (used by script assistant/transcription if managed key is empty)
OPENAI_API_KEY=
