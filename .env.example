# App URL (used in Twilio and PayPal callbacks)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional dashboard access protection
# If APP_ACCESS_PASSWORD is set, the app requires login at /login
APP_ACCESS_USERNAME=admin
APP_ACCESS_PASSWORD=
# Auth mode:
# - accounts (recommended): per-user email/password accounts
# - legacy: shared admin login only
AUTH_MODE=accounts
# Keep false in production unless you intentionally need legacy fallback while in account mode
ALLOW_LEGACY_AUTH=false
# Strong random secret used to sign account session cookies
APP_SESSION_SECRET=change-this-to-a-long-random-string
# Optional email provider for forgot-password emails (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_REPLY_TO=

# Data store driver
# - postgres: use Neon/Postgres via Prisma (recommended for production)
# - filesystem: local JSON files under data/ (quick local testing)
STORE_DRIVER=postgres

# Optional override for filesystem storage location.
# On Vercel, filesystem mode automatically uses /tmp/auto-caller-data.
# DATA_DIR=/tmp/auto-caller-data

# Neon / Postgres connection string
# Example: postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/autocaller?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB_NAME?sslmode=require

# PayPal billing
# Set PAYPAL_MODE=live for production
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Required in production to verify /api/paypal/webhook signatures
PAYPAL_WEBHOOK_ID=

# Managed mode (customers do NOT need API keys)
MANAGED_MODE=true
MANAGED_TWILIO_ACCOUNT_SID=
MANAGED_TWILIO_AUTH_TOKEN=
MANAGED_TWILIO_PHONE_NUMBER=
MANAGED_DEFAULT_NUMBER=
MANAGED_NUMBER_POOL=+12025550111,+12025550112
MANAGED_AUTO_PROVISION_NUMBER=true
MANAGED_NUMBER_COUNTRY=US
MANAGED_NUMBER_AREA_CODE=
MANAGED_NUMBER_CONTAINS=
MANAGED_NUMBER_ACTIVATION_PRICE=39
MANAGED_ASSIGN_NUMBER_ON_REGISTRATION=false
MANAGED_GOOGLE_AI_API_KEY=
MANAGED_OPENAI_API_KEY=
MANAGED_ELEVENLABS_API_KEY=
# Optional ElevenLabs model override for call TTS
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# Optional ElevenLabs realism tuning for phone calls
ELEVENLABS_VOICE_STABILITY=0.26
ELEVENLABS_VOICE_SIMILARITY_BOOST=0.90
ELEVENLABS_VOICE_STYLE=0.68
ELEVENLABS_VOICE_SPEED=1
ELEVENLABS_USE_SPEAKER_BOOST=true
ELEVENLABS_OPTIMIZE_STREAMING_LATENCY=3
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
# Optional dedicated signing secret for /api/calls/tts signed URLs
TTS_SIGNING_SECRET=

# AI provider (Google is primary)
GOOGLE_AI_API_KEY=
GOOGLE_AI_MODEL=gemini-1.5-flash
# Live call conversation model (optional override; defaults to GOOGLE_AI_MODEL)
AI_CALL_MODEL=
# Set false to force legacy one-shot script playback flow
AI_CONVERSATION_MODE=true
# Humanization controls for live AI phone behavior
AI_CALL_HUMANIZATION_LEVEL=high
AI_CALL_EXPRESSIVE_MODE=true
AI_CALL_ALLOW_LAUGH=true
# Optional OpenAI fallback
OPENAI_API_KEY=
# Optional OpenAI conversation model override
OPENAI_CALL_MODEL=gpt-4o-mini

# Secures /api/cron/dispatch-scheduled endpoint for Vercel cron
CRON_SECRET=change-this-to-a-long-random-string
# Compliance call window (lead local time)
CALL_WINDOW_START_HOUR=8
CALL_WINDOW_END_HOUR=21
# Used when a lead timezone is not provided
CALL_COMPLIANCE_DEFAULT_TIMEZONE=America/New_York

# Credit pricing model (server-side)
# Packs are fixed at 30 / 60 / 90 / 140 / 200 credits.
# Example below gives 100% margin on estimated Twilio call cost:
# estimated $0.02 call cost * 2.0 multiplier = $0.04 per credit sold
TWILIO_ESTIMATED_COST_PER_CALL_USD=0.02
CREDIT_MARGIN_MULTIPLIER=2.0

# Landing page live demo call
DEMO_CALL_ENABLED=true
# Optional explicit Twilio creds for demo calls. Falls back to MANAGED_TWILIO_*.
DEMO_TWILIO_ACCOUNT_SID=
DEMO_TWILIO_AUTH_TOKEN=
DEMO_TWILIO_FROM_NUMBER=
DEMO_CALL_AGENT_NAME=Sara
DEMO_CALL_BUSINESS_NAME=Acaller
DEMO_CALL_LANGUAGE=en-US
DEMO_CALL_TWILIO_VOICE=alice
DEMO_CALL_MAX_TURNS=2
# Optional custom blueprint for demo AI conversation.
DEMO_CALL_BRIEF=
# Abuse control: max demo requests per IP in 15-minute window.
DEMO_CALL_MAX_PER_IP_15M=5
